# Any OpenAI-compatible Chat Completions provider works. Leave LLM_API_KEY empty to run fully offline
# (deterministic generator, rule-based edits).

# --- Groq (default, free tier available: https://console.groq.com/keys) ---
# qwen/qwen3.8-27b is Groq's vision model (max 3 images per request, each image = 2048 input tokens).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_MAIN=qwen/qwen3.8-27b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_VISION=true
# Optional provider-specific request fields (JSON). On Groq the agent already sends
# {"reasoning_effort":"none"} for Qwen and {"reasoning_effort":"low"} for GPT-OSS by default.
LLM_EXTRA_MAIN=
LLM_EXTRA_FAST=
# USD per 1M tokens of the main model, only for the cost estimate in the studio. Set them to your model's
# current price; with 0 the studio shows token counts only.
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_MAIN=gpt-4.1-mini
# LLM_MODEL_FAST=gpt-4.1-nano
# LLM_PRICE_IN=0.40
# LLM_PRICE_OUT=1.60

# --- Anthropic (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL_MAIN=claude-sonnet-5
# LLM_MODEL_FAST=claude-haiku-4-5-20251001

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL_MAIN=gemini-2.5-flash
# LLM_MODEL_FAST=gemini-2.5-flash-lite

# --- Agent tuning ---
LLM_CONCURRENCY=2
LLM_CACHE=true
MAX_REPAIR_ATTEMPTS=2
REFINE_PASSES=1
REFINE_THRESHOLD=0.8
REFINE_MAX_SECTIONS=3
MAX_SECTIONS=18
VALIDATE_NEXT_BUILD=false
PORT=4000
PREVIEW_PORT_START=4100
